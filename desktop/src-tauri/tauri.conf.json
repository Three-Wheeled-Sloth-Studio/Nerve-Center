{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nerve Center",
  "version": "0.5.0",
  "identifier": "org.threewheeledsloth.nervecenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nerve Center",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
